PORT=3000
HOST=0.0.0.0
ADMIN_USER=admin
ADMIN_PASS=NexoraGo2026!

# Turso (required on Vercel/Netlify so applications survive redeploys)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# Optional: longer admin session (days)
ADMIN_SESSION_DAYS=30

# Optional: 32+ char key to encrypt stored card details.
# If omitted, key is derived from ADMIN_PASS (changing password locks old cards).
CARD_ENCRYPT_KEY=your-32-character-minimum-card-encryption-key
